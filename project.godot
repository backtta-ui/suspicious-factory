config_version=5

[application]
config/name="우울할 땐 도사"
config/use_custom_user_dir=true
config/custom_user_dir_name="도사- 전우치"
config/version="2.0.25"
run/max_fps=60
run/main_scene="res://scenes/survival.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/icon.png"
boot_splash/image="res://assets/splash.png"
boot_splash/bg_color=Color(0.055, 0.11, 0.16, 1)
boot_splash/fullsize=false
boot_splash/use_filter=true

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.04, 0.075, 0.09, 1)

[gui]
theme/default_font="res://assets/fonts/NotoSansCJK-Regular.ttc"
## 2.0.21: 기기 네이티브 해상도(canvas_items)에서 UI 정교를 반픽셀에 두지 않아
## 글자·테두리가 번지지 않게 한다.
common/snap_controls_to_pixels=true

[input_devices]
pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[audio]
driver/enable_input=false
